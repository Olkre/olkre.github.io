---
import logo from "../assets/gym/logo.png";
import screensPng from "../assets/gym/screens.png";
import screensHoverPng from "../assets/gym/screens_hover.png";
import GymBenefitWrCard from "./GymBenefitWrCard";
import type { BenefitIcon } from "./BoltCard";
import chinTransitionVideo from "../assets/gym/uidemos/chin_transition-autoplay.mp4";
import prDemoVideo from "../assets/gym/uidemos/PR_demo-autoplay.mp4";
import timerSettingsVideo from "../assets/gym/uidemos/timer_settings-autoplay.mp4";
import chinTransitionIosGif from "../assets/gym/uidemos/ios/chin_transition.gif";
import prDemoIosGif from "../assets/gym/uidemos/ios/PR_demo.gif";
import timerSettingsIosGif from "../assets/gym/uidemos/ios/timer_settings.gif";
import dynamicIslandCompact from "../assets/gym/dynamic_island/List.png";
import dynamicIslandRestBreak from "../assets/gym/dynamic_island/List-1.png";
import dynamicIslandSession from "../assets/gym/dynamic_island/List-2.png";

const BENEFIT_CARDS: {
  title: string;
  description: string;
  variant: BenefitIcon;
  alt: string;
  width: number;
}[] = [
  {
    title: "Progressive overload",
    description:
      "Suggested values, beat your PR, and track progress on reps and weight.",
    variant: "bolt",
    alt: "Progressive overload",
    width: 209,
  },
  {
    title: "Compete with friends",
    description:
      "See what your friends are up to in the app and stay motivated together.",
    variant: "friends",
    alt: "Compete with friends",
    width: 209,
  },
  {
    title: "Track your rest",
    description:
      "Use a customizable built-in timer to optimize recovery between sets.",
    variant: "timer",
    alt: "Track your rest",
    width: 209,
  },
];

const dynamicIslandSlides = [
  {
    src: dynamicIslandCompact,
    alt: "iPhone home screen with a compact Dynamic Island rest timer",
  },
  {
    src: dynamicIslandRestBreak,
    alt: "iPhone home screen with an expanded Dynamic Island rest break controls",
  },
  {
    src: dynamicIslandSession,
    alt: "iPhone home screen with an expanded Dynamic Island active workout session",
  },
] as const;

const VIDEO_CARDS = [
  {
    id: "timer",
    src: timerSettingsVideo,
    iosGif: timerSettingsIosGif,
    alt: "Rest timer settings demo",
    width: 347,
    triggerClass: "gym-demo-timer",
    videoClass: "gym-demo-video-timer",
    bg: "bg-gradient-to-b from-[#003366] to-[#003266]",
  },
  {
    id: "chin",
    src: chinTransitionVideo,
    iosGif: chinTransitionIosGif,
    alt: "Chin transition demo",
    width: 318,
    triggerClass: "gym-demo-chin",
    videoClass: "gym-demo-video-chin",
    bg: "bg-black",
  },
  {
    id: "pr",
    src: prDemoVideo,
    iosGif: prDemoIosGif,
    alt: "Personal record demo",
    width: 305,
    triggerClass: "gym-demo-pr",
    videoClass: "gym-demo-video-pr",
    bg: "bg-white",
  },
] as const;

const SCREENS_HEIGHT = 262;
const SCREENS_PAD = 16;
const SCREENS_INNER_HEIGHT = SCREENS_HEIGHT - SCREENS_PAD * 2;
const SCREENS_WIDTH =
  Math.round((screensPng.width / screensPng.height) * SCREENS_INNER_HEIGHT) +
  SCREENS_PAD * 2;
const ISLAND_WIDTH = 501;

const DOT_LABELS = [
  "App screenshots",
  "Dynamic Island previews",
  ...BENEFIT_CARDS.map((c) => c.alt),
  ...VIDEO_CARDS.map((c) => c.alt),
] as const;
---

<div class="gym-app mb-12 flex w-full flex-col gap-3">
  <div class="flex w-full flex-wrap items-center gap-x-3 gap-y-2.5 sm:gap-x-4">
    <a
      href="https://sgym.space"
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4"
      aria-label="Sasha's Gym App — open sgym.space"
    >
      <span class="gym-icon gym-squircle relative size-[54px] shrink-0 overflow-hidden bg-white">
        <img
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt=""
          class="absolute inset-0 size-full object-cover"
          decoding="async"
        />
      </span>
      <span class="flex min-w-0 flex-col justify-center gap-1.5">
        <span
          class="truncate text-[20px] font-semibold leading-none tracking-[-0.4px] text-black"
        >
          Sasha's Gym App
        </span>
        <span
          class="truncate text-[12px] font-normal leading-none text-black opacity-60"
        >
          Fitness tracking iOS and Android application
        </span>
      </span>
    </a>

    <a
      href="https://sgym.space"
      target="_blank"
      rel="noopener noreferrer"
      class="order-2 flex shrink-0 items-center rounded-[40px] bg-[#155dfc] py-1 pl-3 pr-2 text-[12px] leading-none text-white transition-transform duration-200 ease-out hover:scale-[1.02] hover:bg-[#0f4fd4] active:scale-[0.98] sm:order-3"
    >
      sgym.space
      <span
        class="ms-0.5 inline-flex size-[16px] items-center justify-center text-white"
        aria-hidden="true"
      >
        <span class="inline-block -rotate-45">→</span>
      </span>
    </a>

    <div
      class="order-3 flex w-full items-center justify-start gap-0.5 pl-[calc(54px+0.75rem)] sm:order-2 sm:w-auto sm:justify-start sm:pl-0"
    >
      <button
        type="button"
        class="gym-chevron gym-chevron-prev"
        aria-label="Previous preview"
        disabled
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M10 3.5 5.5 8 10 12.5"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <div
        class="gym-dots flex items-center rounded-full bg-black/[0.06] px-1.5 py-0.5"
        role="tablist"
        aria-label="Preview pagination"
      >
        {
          DOT_LABELS.map((label, i) => (
            <button
              type="button"
              class:list={["gym-dot", i === 0 && "is-active"]}
              data-index={i}
              aria-label={`Show ${label}`}
              aria-current={i === 0 ? "true" : undefined}
            />
          ))
        }
      </div>
      <button
        type="button"
        class="gym-chevron gym-chevron-next"
        aria-label="Next preview"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 3.5 10.5 8 6 12.5"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="gym-wrcards-wrap -my-2">
    <div
      class="gym-wrcards flex overflow-x-auto py-2"
      role="list"
      aria-label="Sasha's Gym App feature previews"
    >
      {/* App screenshots strip */}
      <div role="listitem" class="gym-card-hit-area" style={`width: ${SCREENS_WIDTH}px`}>
        <a
          href="https://sgym.space"
          target="_blank"
          rel="noopener noreferrer"
          class="gym-squircle gym-squircle--card gym-screens group relative block h-full w-full overflow-hidden bg-white p-4 [transform:translateZ(0)] transition-transform duration-300 ease-out will-change-transform focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2"
          aria-label="Four screenshots of Sasha's Gym App on iPhone — open sgym.space"
        >
          <span class="gym-screens-stack grid h-full w-full [&>*]:col-start-1 [&>*]:row-start-1">
            <img
              class="gym-screens-hover block h-full w-full object-contain object-left opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100 motion-reduce:opacity-0"
              src={screensHoverPng.src}
              width={screensHoverPng.width}
              height={screensHoverPng.height}
              alt=""
              aria-hidden="true"
              decoding="async"
            />
            <img
              class="relative z-[1] block h-full w-full object-contain object-left drop-shadow-none transition-[filter] duration-300 ease-out group-hover:drop-shadow-[0_3px_4px_rgba(17,17,17,0.32)] motion-reduce:transition-none motion-reduce:group-hover:drop-shadow-none"
              src={screensPng.src}
              width={screensPng.width}
              height={screensPng.height}
              alt="Four screenshots of Sasha's Gym App on iPhone"
              decoding="async"
            />
          </span>
        </a>
      </div>

      {/* Dynamic Island */}
      <div role="listitem" class="gym-card-hit-area" style={`width: ${ISLAND_WIDTH}px`}>
        <a
          href="https://sgym.space"
          target="_blank"
          rel="noopener noreferrer"
          class="gym-squircle gym-squircle--card gym-demo-island group relative block h-full w-full overflow-hidden bg-white px-4 [transform:translateZ(0)] transition-transform duration-300 ease-out will-change-transform focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2"
          aria-label="Dynamic Island workout states — open sgym.space"
        >
        <div
          class="gym-demo-island-stack flex h-full items-start justify-center"
          role="group"
          aria-label="Dynamic Island workout states"
        >
          {
            dynamicIslandSlides.map((slide, slideIndex) => (
              <img
                class="gym-demo-island-phone"
                src={slide.src.src}
                width={slide.src.width}
                height={slide.src.height}
                alt={slide.alt}
                loading={slideIndex === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            ))
          }
        </div>
        </a>
      </div>

      {/* Benefit cards with interactive BoltCard */}
      {
        BENEFIT_CARDS.map((card) => (
          <div role="listitem" class="gym-card-hit-area" style={`width: ${card.width}px`}>
            <a
              href="https://sgym.space"
              target="_blank"
              rel="noopener noreferrer"
              class="gym-squircle gym-squircle--card group relative block h-full w-full overflow-hidden bg-white [transform:translateZ(0)] transition-transform duration-300 ease-out will-change-transform focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2"
              aria-label={`${card.alt} — open sgym.space`}
            >
              <GymBenefitWrCard
                client:load
                title={card.title}
                description={card.description}
                variant={card.variant}
              />
            </a>
          </div>
        ))
      }

      {/* Video demos */}
      {
        VIDEO_CARDS.map((card) => (
          <div role="listitem" class="gym-card-hit-area" style={`width: ${card.width}px`}>
            <a
              href="https://sgym.space"
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "gym-squircle gym-squircle--card group relative block h-full w-full overflow-hidden [transform:translateZ(0)] transition-transform duration-300 ease-out will-change-transform focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2",
                card.triggerClass,
                card.bg,
              ]}
              aria-label={`${card.alt} — open sgym.space`}
            >
              <video
                class:list={["gym-demo-video", card.videoClass, "block h-auto max-h-full w-auto max-w-full"]}
                data-src={card.src}
                autoplay
                loop
                muted
                playsinline
                webkit-playsinline
                preload="auto"
                aria-hidden="true"
              />
              <img
                class:list={["gym-demo-gif", card.videoClass, "block h-auto max-h-full w-auto max-w-full"]}
                data-src={card.iosGif.src}
                width={card.iosGif.width}
                height={card.iosGif.height}
                alt=""
                aria-hidden="true"
                decoding="async"
                draggable="false"
              />
            </a>
          </div>
        ))
      }
    </div>
    <button
      type="button"
      class="gym-reset-control"
      aria-label="Return to first preview"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      hidden
    >
      <span class="gym-reset-ring" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <circle class="gym-reset-track" cx="16" cy="16" r="14"></circle>
          <circle class="gym-reset-progress" cx="16" cy="16" r="14"></circle>
          <path
            class="gym-reset-arrow"
            d="M21.5 11.5A7.25 7.25 0 1 0 23 18"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
          ></path>
          <path
            class="gym-reset-arrow"
            d="M21.5 7.5v4h-4"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>
    </button>
  </div>
</div>

<style>
  :global(html) {
    overflow-x: clip;
  }

  /* Squircle reads tighter than the same radius on a round rect — bump when supported. */
  .gym-squircle {
    --gym-radius: 18px;
    --gym-radius-squircle: 26px;
    border-radius: var(--gym-radius);
  }

  .gym-squircle--card {
    --gym-radius: 16px;
    --gym-radius-squircle: 22px;
  }

  .gym-icon::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background-image: linear-gradient(
      110deg,
      transparent 0%,
      transparent 25%,
      rgba(255, 255, 255, 0.2) 40%,
      rgba(255, 255, 255, 0.95) 50%,
      rgba(255, 255, 255, 0.2) 60%,
      transparent 75%,
      transparent 100%
    );
    background-size: 250% 100%;
    background-repeat: no-repeat;
    background-position: 150% 0;
    mix-blend-mode: overlay;
  }

  .gym-icon.is-shimmering::after {
    opacity: 1;
    animation: bio-metal-shimmer 1.1s linear forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .gym-icon::after {
      display: none;
    }
  }

  @supports (corner-shape: squircle) {
    .gym-squircle {
      corner-shape: squircle;
      border-radius: var(--gym-radius-squircle);
    }
  }

  .gym-dots {
    gap: 0;
  }

  .gym-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(0, 0, 0, 0.45);
    cursor: pointer;
    transition: color 160ms ease-out;
  }

  .gym-chevron:disabled {
    color: rgba(0, 0, 0, 0.18);
    cursor: default;
  }

  @media (hover: hover) and (pointer: fine) {
    .gym-chevron:hover:not(:disabled) {
      color: rgba(0, 0, 0, 0.8);
    }
  }

  .gym-chevron:focus-visible {
    outline: 2px solid #155dfc;
    outline-offset: 1px;
  }

  .gym-dot {
    position: relative;
    width: 10px;
    height: 18px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .gym-dot::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.22);
    transform: translate(-50%, -50%);
    transition:
      background-color 160ms ease-out,
      transform 160ms ease-out;
  }

  .gym-dot.is-active::before {
    background: #111;
    transform: translate(-50%, -50%) scale(1.35);
  }

  @media (hover: hover) and (pointer: fine) {
    .gym-dot:hover:not(.is-active)::before {
      background: rgba(0, 0, 0, 0.45);
      transform: translate(-50%, -50%) scale(1.2);
    }

    .gym-dot.is-active:hover::before {
      transform: translate(-50%, -50%) scale(1.5);
    }
  }

  .gym-dot:active:not(.is-active)::before {
    background: rgba(0, 0, 0, 0.55);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .gym-dot:focus-visible {
    outline: 2px solid #155dfc;
    outline-offset: 1px;
  }

  /* Break out of #content max-w-4xl so the row can scroll edge-to-edge. */
  .gym-wrcards-wrap {
    --gym-gutter: 56rem;
    /* Keep a start inset below max-w; on wide screens match the centered column. */
    --gym-content-pad: max(1rem, calc((100dvw - var(--gym-gutter)) / 2));
    width: 100dvw;
    max-width: 100dvw;
    margin-left: calc(50% - 50dvw);
    position: relative;
    box-sizing: border-box;
    -webkit-mask-image: none;
    mask-image: none;
  }

  @media (min-width: 640px) {
    .gym-wrcards-wrap {
      /* Fade only in the side bleed past the content column (header max width). */
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--gym-content-pad),
        #000 calc(100% - var(--gym-content-pad)),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--gym-content-pad),
        #000 calc(100% - var(--gym-content-pad)),
        transparent 100%
      );
    }
  }

  @supports not (width: 100dvw) {
    .gym-wrcards-wrap {
      --gym-content-pad: max(1rem, calc((100vw - var(--gym-gutter)) / 2));
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
    }
  }

  .gym-wrcards {
    width: 100%;
    overflow-y: hidden;
    gap: 0.5rem;
    padding-inline: var(--gym-content-pad);
    /* Keep horizontal edge gestures inside this carousel instead of handing
       them to browser back/forward navigation. */
    padding-right: calc(var(--gym-content-pad) + 3.5rem);
    overscroll-behavior-x: contain;
    overscroll-behavior-inline: contain;
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gym-content-pad);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  @media (min-width: 640px) {
    .gym-wrcards {
      gap: 0.625rem;
    }
  }

  .gym-wrcards [role="listitem"] {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .gym-card-hit-area {
    position: relative;
    height: 262px;
    flex: 0 0 auto;
  }

  /* Keep the hover target stable while the card lifts on pointer enter. */
  @media (hover: hover) and (pointer: fine) {
    .gym-card-hit-area::before {
      content: "";
      position: absolute;
      z-index: 0;
      inset: -0.5rem;
    }

    .gym-card-hit-area > .gym-squircle--card {
      position: relative;
      z-index: 1;
    }

    .gym-card-hit-area:hover > .gym-squircle--card {
      transform: translate3d(0, -0.375rem, 0);
    }
  }

  .gym-wrcards::-webkit-scrollbar {
    display: none;
  }

  .gym-reset-control {
    --gym-reset-progress: 0;
    position: absolute;
    z-index: 2;
    top: 50%;
    right: var(--gym-content-pad);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: #111;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.14);
    transform: translate(0, -50%) scale(0.82);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 180ms ease-out,
      transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gym-reset-control.is-visible {
    transform: translate(0, -50%) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  .gym-reset-control[hidden] {
    display: none;
  }

  .gym-reset-ring {
    display: block;
    width: 32px;
    height: 32px;
    padding: 2px;
    border-radius: 50%;
    background: conic-gradient(
      #111 calc(var(--gym-reset-progress) * 1%),
      rgba(0, 0, 0, 0.14) 0
    );
    transition: background 80ms linear;
  }

  .gym-reset-ring svg {
    display: block;
    width: 100%;
    height: 100%;
    padding: 5px;
    overflow: visible;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.96);
  }

  .gym-reset-track,
  .gym-reset-progress {
    display: none;
  }

  .gym-reset-arrow {
    fill: none;
  }

  .gym-reset-control:focus-visible {
    outline: 2px solid #155dfc;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .gym-reset-control,
    .gym-reset-ring {
      transition: none;
    }
  }

  /* —— UI demo interactions (from GymAppLanding) —— */
  .gym-demo-island {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .gym-demo-island-stack {
    --gym-island-ladder-start: 1.15rem;
    --gym-island-ladder-mid: 3.6rem;
    --gym-island-ladder-end: 7.1rem;
    --gym-island-lift: 1.25rem;
    perspective: 1200px;
    perspective-origin: center top;
    height: 100%;
  }

  .gym-demo-island-phone {
    --gym-island-scale: 1.72;
    --gym-island-ladder-y: 0px;
    position: relative;
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    flex: 0 0 auto;
    object-fit: cover;
    object-position: top center;
    margin-left: -3.4rem;
    transform: translate3d(0, var(--gym-island-ladder-y), 0)
      scale(var(--gym-island-scale));
    transform-origin: top center;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .gym-demo-island-phone:first-child {
    --gym-island-ladder-y: var(--gym-island-ladder-start);
    margin-left: 0;
    z-index: 1;
  }

  .gym-demo-island-phone:nth-child(2) {
    --gym-island-ladder-y: var(--gym-island-ladder-mid);
    z-index: 2;
  }

  .gym-demo-island-phone:nth-child(3) {
    --gym-island-ladder-y: var(--gym-island-ladder-end);
    z-index: 3;
  }

  .gym-demo-timer {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    perspective: 1200px;
    perspective-origin: right top;
  }

  .gym-demo-video-timer {
    transform: translate3d(0.75rem, -0.1rem, 0);
    transform-origin: top right;
    backface-visibility: hidden;
    will-change: transform;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gym-demo-chin {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    perspective: 1200px;
    perspective-origin: center top;
  }

  .gym-demo-video-chin {
    transform: translate3d(0, -0.75rem, 0) scale(1.18);
    transform-origin: top center;
    backface-visibility: hidden;
    will-change: transform;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gym-demo-pr {
    --gym-pr-rest-y: -2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    perspective-origin: center top;
  }

  .gym-demo-video-pr {
    transform: translate3d(0, var(--gym-pr-rest-y), 0) scale(1.38);
    transform-origin: top center;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gym-demo-gif {
    display: none;
  }

  .gym-app.is-ios .gym-demo-video {
    display: none;
  }

  .gym-app.is-ios .gym-demo-gif {
    display: block;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .gym-demo-island-phone:hover {
      transform: translate3d(
          0,
          calc(var(--gym-island-ladder-y) - var(--gym-island-lift)),
          0
        )
        scale(var(--gym-island-scale));
    }

    .gym-demo-timer:hover .gym-demo-video-timer {
      transform: translate3d(0, -0.1rem, 0);
    }

    .gym-demo-chin:hover .gym-demo-video-chin {
      transform: translate3d(0, 0, 0) scale(1.18);
    }

    .gym-demo-pr:hover .gym-demo-video-pr {
      transform: translate3d(0, var(--gym-pr-rest-y), 0) scale(1.38)
        rotateX(15deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gym-demo-island-phone {
      transition: none;
    }

    .gym-demo-video-timer,
    .gym-demo-video-chin,
    .gym-demo-video-pr {
      transform: none;
      transition: none;
    }
  }

  /* Paper LiquidMetal canvas defaults to z-index:-1; keep it above card chrome. */
  .gym-wrcards :global([data-paper-shader]) {
    isolation: isolate;
  }

  .gym-wrcards :global([data-paper-shader] canvas) {
    z-index: 0;
  }
</style>

<script>
  function initGymWrcards() {
    const root = document.querySelector(".gym-app");
    if (!root) return;

    if (typeof root._gymCleanup === "function") root._gymCleanup();

    const scroller = root.querySelector(".gym-wrcards");
    const cards = [...root.querySelectorAll(".gym-wrcards [role='listitem']")];
    if (!scroller || !cards.length) return;

    const ac = new AbortController();
    const { signal } = ac;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const PULL_THRESHOLD = 1200;
    const resetControl = root.querySelector(".gym-reset-control");
    let resetHideTimer = null;
    let wheelResetTimer = null;
    root._gymCleanup = () => {
      ac.abort();
      if (resetHideTimer != null) window.clearTimeout(resetHideTimer);
      if (wheelResetTimer != null) window.clearTimeout(wheelResetTimer);
    };

    function getDots() {
      return [...root.querySelectorAll(".gym-dot")];
    }

    function getActive() {
      const dots = getDots();
      const i = dots.findIndex((d) => d.classList.contains("is-active"));
      return i >= 0 ? i : 0;
    }

    function syncChevrons(index) {
      const prevBtn = root.querySelector(".gym-chevron-prev");
      const nextBtn = root.querySelector(".gym-chevron-next");
      if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = index <= 0;
      if (nextBtn instanceof HTMLButtonElement) {
        nextBtn.disabled = index >= cards.length - 1;
      }
    }

    function setActive(index) {
      const dots = getDots();
      dots.forEach((dot, i) => {
        const on = i === index;
        dot.classList.toggle("is-active", on);
        if (on) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      syncChevrons(index);
    }

    function nearestIndex() {
      const maxScroll = scroller.scrollWidth - scroller.clientWidth;
      if (maxScroll > 0 && scroller.scrollLeft >= maxScroll - 2) {
        return cards.length - 1;
      }
      if (scroller.scrollLeft <= 2) return 0;

      const pad = parseFloat(getComputedStyle(scroller).paddingLeft) || 0;
      const target = scroller.scrollLeft + pad;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft - target);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    }

    function scrollToIndex(index) {
      const clamped = Math.max(0, Math.min(cards.length - 1, index));
      const card = cards[clamped];
      if (!card) return;
      const pad = parseFloat(getComputedStyle(scroller).paddingLeft) || 0;
      const maxScroll = scroller.scrollWidth - scroller.clientWidth;
      const left =
        clamped === cards.length - 1
          ? maxScroll
          : Math.min(maxScroll, Math.max(0, card.offsetLeft - pad));
      scroller.scrollTo({
        left,
        behavior: reduceMotion ? "auto" : "smooth",
      });
      setActive(clamped);
    }

    // Native scrolling clamps at the last snap point, so track the extra
    // edge movement ourselves and wrap after a deliberate pull.
    let lastPointerX = null;
    let edgePull = 0;
    let wheelEdgePull = 0;

    function isAtEnd() {
      return scroller.scrollLeft >= scroller.scrollWidth - scroller.clientWidth - 1;
    }

    function returnToStart() {
      edgePull = 0;
      wheelEdgePull = 0;
      setResetProgress(0);
      scrollToIndex(0);
    }

    function setResetProgress(value) {
      if (!(resetControl instanceof HTMLButtonElement)) return;

      const progress = Math.max(0, Math.min(1, value));
      const percent = Math.round(progress * 100);
      resetControl.style.setProperty("--gym-reset-progress", String(percent));
      resetControl.setAttribute("aria-valuenow", String(percent));

      if (progress > 0) {
        if (resetHideTimer != null) window.clearTimeout(resetHideTimer);
        resetControl.hidden = false;
        resetControl.classList.add("is-visible");
      } else if (!resetControl.hidden) {
        resetControl.classList.remove("is-visible");
        if (resetHideTimer != null) window.clearTimeout(resetHideTimer);
        resetHideTimer = window.setTimeout(() => {
          resetControl.hidden = true;
          resetHideTimer = null;
        }, reduceMotion ? 0 : 220);
      }
    }

    scroller.addEventListener(
      "pointerdown",
      (event) => {
        lastPointerX = event.clientX;
        edgePull = 0;
      },
      { signal },
    );

    scroller.addEventListener(
      "pointermove",
      (event) => {
        if (lastPointerX == null) return;

        const movement = lastPointerX - event.clientX;
        if (isAtEnd() && movement > 0) {
          edgePull += movement;
          setResetProgress(edgePull / PULL_THRESHOLD);
        } else if (movement < 0) {
          edgePull = 0;
          setResetProgress(0);
        }
        lastPointerX = event.clientX;
      },
      { passive: true, signal },
    );

    scroller.addEventListener(
      "pointerup",
      () => {
        if (edgePull >= PULL_THRESHOLD) returnToStart();
        else setResetProgress(0);
        lastPointerX = null;
        edgePull = 0;
      },
      { signal },
    );

    scroller.addEventListener(
      "pointercancel",
      () => {
        lastPointerX = null;
        edgePull = 0;
        setResetProgress(0);
      },
      { signal },
    );

    scroller.addEventListener(
      "wheel",
      (event) => {
        const horizontalDelta =
          Math.abs(event.deltaX) >= Math.abs(event.deltaY)
            ? event.deltaX
            : event.shiftKey
              ? event.deltaY
              : 0;

        if (!isAtEnd() || horizontalDelta <= 0) {
          wheelEdgePull = 0;
          setResetProgress(0);
          return;
        }

        wheelEdgePull += horizontalDelta;
        setResetProgress(wheelEdgePull / PULL_THRESHOLD);
        if (wheelResetTimer != null) window.clearTimeout(wheelResetTimer);
        wheelResetTimer = window.setTimeout(() => {
          wheelEdgePull = 0;
          wheelResetTimer = null;
        }, 180);

        if (wheelEdgePull >= PULL_THRESHOLD) returnToStart();
      },
      { passive: true, signal },
    );

    resetControl?.addEventListener(
      "click",
      () => returnToStart(),
      { signal },
    );

    scroller.addEventListener(
      "scroll",
      () => {
        setActive(nearestIndex());
      },
      { passive: true, signal },
    );

    root.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const prev = target.closest(".gym-chevron-prev");
        if (prev instanceof HTMLButtonElement && !prev.disabled) {
          event.preventDefault();
          scrollToIndex(getActive() - 1);
          return;
        }

        const next = target.closest(".gym-chevron-next");
        if (next instanceof HTMLButtonElement && !next.disabled) {
          event.preventDefault();
          scrollToIndex(getActive() + 1);
          return;
        }

        const dot = target.closest(".gym-dot");
        if (dot instanceof HTMLButtonElement && dot.dataset.index != null) {
          scrollToIndex(Number(dot.dataset.index));
        }
      },
      { signal },
    );

    setActive(getActive());

    const icon = root.querySelector(".gym-icon");
    const canHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    if (icon && canHover && !reduceMotion) {
      icon.addEventListener(
        "pointerenter",
        () => {
          if (icon.dataset.shimmerRunning === "1") return;
          icon.dataset.shimmerRunning = "1";

          const onEnd = (event) => {
            if (!(event.animationName || "").startsWith("bio-metal-shimmer")) {
              return;
            }
            icon.classList.remove("is-shimmering");
            icon.dataset.shimmerRunning = "0";
            icon.removeEventListener("animationend", onEnd);
          };

          icon.addEventListener("animationend", onEnd);
          icon.classList.add("is-shimmering");
        },
        { signal },
      );
    }

    const ua = navigator.userAgent;
    const isIos =
      /iPhone|iPad|iPod/i.test(ua) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    if (isIos) {
      root.classList.add("is-ios");
      root.querySelectorAll(".gym-demo-gif").forEach((image) => {
        if (!(image instanceof HTMLImageElement)) return;
        const source = image.dataset.src;
        if (source) image.src = source;
      });
      return;
    }

    function prime(video) {
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute("muted", "");
      video.setAttribute("playsinline", "");
      video.setAttribute("webkit-playsinline", "");
    }

    function tryPlay(video) {
      prime(video);
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === "function") {
        playPromise.catch(() => {
          video.addEventListener(
            "loadeddata",
            function onReady() {
              video.removeEventListener("loadeddata", onReady);
              video.play().catch(() => {});
            },
            { once: true },
          );
        });
      }
    }

    root.querySelectorAll(".gym-demo-video").forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      const source = video.dataset.src;
      if (source) video.src = source;
      tryPlay(video);

      if (!("IntersectionObserver" in window)) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) tryPlay(video);
            else video.pause();
          });
        },
        { root: scroller, threshold: 0.2 },
      );
      observer.observe(video);
      signal.addEventListener("abort", () => observer.disconnect());
    });
  }

  initGymWrcards();
  document.addEventListener("astro:page-load", initGymWrcards);
</script>
