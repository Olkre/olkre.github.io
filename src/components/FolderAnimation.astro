<div class="gym-app flex w-full flex-col gap-2 !rounded-none !border-0 !bg-transparent !p-0">
  <div class="case-header flex w-full justify-between p-4 pb-1">
    <h4>3D folder animation</h4>
    <a
      target="_blank"
      href="https://x.com/ol_dsn/status/1877561233219395909"
      class="md:block hidden next-btn1 group w-fit rounded-full p-0 transition-all duration-300"
    >
      <div class="next-btn-container h-full w-full rounded-full border border-gray-100 bg-white p-0.5">
        <div class="case-link next-btn-content inline-flex h-full w-full items-center justify-center rounded-full">
          Tweet <span class="ms-1">→</span>
        </div>
      </div>
    </a>
  </div>

  <div class="case-card video-hover-trigger overflow-hidden rounded-4xl bg-white p-2">
    <div class="relative overflow-hidden rounded-3xl bg-white">
      <button
        type="button"
        class="hover-to-play-control folder-play absolute left-3 top-4 z-10"
      >
        <svg class="hover-to-play-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="5.6" stroke="currentColor" stroke-width="1.1" stroke-dasharray="1.2 2.2" />
          <circle cx="8" cy="8" r="3.5" stroke="currentColor" stroke-width="1" stroke-dasharray="0.8 1.7" />
          <circle cx="8" cy="8" r="1.55" fill="currentColor" />
        </svg>
        <span>Hover to Play</span>
      </button>
      <video
        muted
        loop
        playsinline
        class="folder-video block w-full rounded-3xl"
        aria-label="3D folder animation"
      >
        <source src="/images/case2.webm" type="video/webm" />
        <source src="/images/case2.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</div>

<script>
  const folderCards = document.querySelectorAll(".folder-video");

  folderCards.forEach((video) => {
    const playLabel = video.parentElement?.querySelector(".folder-play span:last-child");
    if (!playLabel) return;

    video.addEventListener("mouseenter", () => {
      video.play();
      playLabel.textContent = "Playing";
    });

    video.addEventListener("mouseleave", () => {
      video.pause();
      playLabel.textContent = "Hover to Play";
    });
  });
</script>

<style>
  .folder-video {
    transform: scale(1);
    transform-origin: center;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .video-hover-trigger:hover .folder-video {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-video {
      transition: none;
    }
  }
</style>
