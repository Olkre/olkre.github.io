<div class="gym-app mb-12 flex w-full flex-col gap-2 !rounded-none !border-0 !bg-transparent !p-0">
  <div class="case-header flex w-full justify-between p-4 pb-1">
    <h4>3D folder animation</h4>
    <a
      target="_blank"
      href="https://x.com/ol_dsn/status/1877561233219395909"
      class="md:block hidden next-btn1 group w-fit rounded-full p-0 transition-all duration-300"
    >
      <div class="next-btn-container h-full w-full rounded-full border border-gray-100 bg-white p-0.5">
        <div class="case-link next-btn-content inline-flex h-full w-full items-center justify-center rounded-full px-2 py-0 text-sm font-medium">
          Tweet <span class="ms-1">→</span>
        </div>
      </div>
    </a>
  </div>

  <div class="case-card video-hover-trigger overflow-hidden rounded-4xl bg-white p-2">
    <div class="relative overflow-hidden rounded-3xl bg-white">
      <button
        type="button"
        class="folder-play absolute left-3 top-4 z-10 flex items-center gap-1 rounded-3xl bg-black/5 px-1 pe-2 text-sm tracking-tighter text-gray-500"
      >
        <span aria-hidden="true">◉</span>
        <span>Hover to Play</span>
      </button>
      <video
        muted
        loop
        playsinline
        class="folder-video block w-full rounded-3xl"
        aria-label="3D folder animation"
      >
        <source src="/images/case2.webm" type="video/webm" />
        <source src="/images/case2.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</div>

<script>
  const folderCards = document.querySelectorAll(".folder-video");

  folderCards.forEach((video) => {
    const playLabel = video.parentElement?.querySelector(".folder-play span:last-child");
    if (!playLabel) return;

    video.addEventListener("mouseenter", () => {
      video.play();
      playLabel.textContent = "Playing";
    });

    video.addEventListener("mouseleave", () => {
      video.pause();
      playLabel.textContent = "Hover to Play";
    });
  });
</script>
